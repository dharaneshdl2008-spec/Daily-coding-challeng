class Solution {
    public boolean isMatch(String s, String p) {
        int [][] cm = new int[s.length()][p.length()]; //cm = catchmemo
        for(int i = 0; i< s.length() ;i++){
            for( int j = 0; j< p.length(); j++){
                cm[i][j] = -1;
            }
        }
        int output = isMatch(s , p ,s.length()-1 , p.length()-1 , cm);

        return output>0?true: false;
    }

    private int isMatch(String s , String p, int i, int j, int[][] cm){
        if(i < 0 && j < 0){
            return 1;
        }
        if(i >= 0 && j < 0){
            return 0;
        }
        if(i < 0 && j>= 0){
            for(int z = j; z>= 0; z--){
                if(p.charAt(z) != '*'){
                    return 0;
                }
            }
            return 1;
        }
        if(cm[i][j] != -1){
            return cm[i][j];
        }

        if(s.charAt(i) == p.charAt(j) || p.charAt(j) == '?'){
            cm[i][j] = isMatch(s, p, i-1, j-1, cm);
            return cm[i][j];
        }

        if(p.charAt(j) == '*'){
            if(isMatch(s, p, i-1, j, cm) == 1 || isMatch(s, p, i, j-1, cm) == 1){
                cm[i][j] = 1;
            }else{
                cm[i][j] = 0;
            }
            return cm[i][j];
        }
        return 0;
    }
}



class Solution {
    public int jump(int[] nums) {
        int n = nums.length;
        if (n <= 1) return 0;

        int jumps = 0;
        int currEnd = 0;
        int maxReach = 0;

        // Process indices until second last.
        for (int i = 0; i < n - 1; i++) {
            maxReach = Math.max(maxReach, i + nums[i]);

            // End of current range => commit one jump.
            if (i == currEnd) {
                jumps++;
                currEnd = maxReach;

                // If this range already covers last index, stop.
                if (currEnd >= n - 1) break;
            }
        }

        return jumps;
    }
}
